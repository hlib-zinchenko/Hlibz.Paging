<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>

    <!--
        EF Core per major, matching each target framework: a net10.0 consumer gets EF Core 10, a
        net11.0 one EF Core 11. Both are minimums: packed as ">=" dependencies, so an app picks any
        newer patch itself. Dependabot only takes patch and minor updates.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    </ItemGroup>
</Project>
